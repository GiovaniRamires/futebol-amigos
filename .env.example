# Copie este arquivo para ".env" e ajuste os valores antes de rodar `docker compose up`.
# NUNCA versione o arquivo ".env" real (ja esta no .gitignore).

DB_NAME=futebol_amigos
DB_USER=futebol
DB_PASSWORD=troque_esta_senha
DB_ROOT_PASSWORD=troque_esta_senha_root

# Administrador inicial, criado automaticamente no primeiro start se nenhum
# ADMINISTRADOR existir ainda no banco. Se ADMIN_SENHA ficar em branco, uma
# senha aleatoria e gerada e exibida UMA UNICA VEZ no log da aplicacao.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@futebolamigos.local
ADMIN_SENHA=
